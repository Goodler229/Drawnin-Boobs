# обов'язково
IMAP_HOST=imap.company.com
# за потреби
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER_IS_EMAIL=false   # якщо логін на IMAP без @домену
# IMAP_REJECT_UNAUTHORIZED=false   # лише для самопідписаних сертифікатів
ALLOWED_DOMAINS=company.com
# TRUST_PROXY=1   # якщо стоїть за nginx/Caddy
# SECRET=довгий-випадковий-рядок   # інакше згенерується в /data/secret
